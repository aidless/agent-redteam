# Agent Red Team Platform — Environment Variable Template
#
# USAGE:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in your real API keys below
#   3. .env is gitignored (NEVER commit real keys)
#
# These variables are read by:
#   - targets/openai_target.py  -> OPENAI_API_KEY
#   - targets/anthropic_target.py -> ANTHROPIC_API_KEY
#   - targets/local_target.py  -> LOCAL_LLM_BASE_URL, LOCAL_LLM_API_KEY

# ============================================================================
# OpenAI  (https://platform.openai.com/api-keys)
# ============================================================================
OPENAI_API_KEY=sk-your-real-key-here

# Optional: OpenAI organization ID
# OPENAI_ORG_ID=org-your-org-id

# Optional: Override base URL (for OpenAI-compatible proxies like vLLM, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# Anthropic  (https://console.anthropic.com/)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Optional: Override base URL
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================================================================
# Local llama.cpp server (https://github.com/ggerganov/llama.cpp)
# ============================================================================
# Default assumes server is running on localhost:8080 (OpenAI-compatible mode)
LOCAL_LLM_BASE_URL=http://localhost:8080/v1

# Most local servers don't enforce API keys; placeholder is fine
LOCAL_LLM_API_KEY=not-required